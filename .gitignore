# THE-GATHERING — Master .gitignore
# RSP_001 / NOIZY Empire / GOD.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
venv/
.venv/
env/
.env/
ENV/

# ── Node / JS ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.tsbuildinfo
.next/
.cache/

# ── Secrets & Keys (NEVER commit these) ──────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
.secrets/
wrangler.toml.bak

# ── Databases (local runtime state) ──────────────────────────
*.db
*.sqlite
*.sqlite3
*.duckdb
memory/chroma/

# ── Ollama / AI Models (huge) ────────────────────────────────
*.gguf
*.bin
*.safetensors
models/
.ollama/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
*.icloud

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*~

# ── Logs & temp ───────────────────────────────────────────────
logs/
*.log
*.tmp
*.bak
*.orig
_quarantine_duplicates/
reports/

# ── Audio / Media (large — keep in THE-AQUARIUM) ─────────────
*.wav
*.aiff
*.flac
*.mp3
*.mp4
*.mov

# ── Build artifacts ───────────────────────────────────────────
target/
*.class
*.jar
*.dylib
