# Exclude huge installers and manuals in 00_DLS
00_DLS/

# Exclude common large binary formats
*.dmg
*.pkg
*.zip
*.7z
*.tar.gz
*.epub
*.pdf
*.exe
*.msi
*.iso

# ── Node / JS ─────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
*.tsbuildinfo
.next/
.cache/
**/dist/

# ── Secrets & Keys (NEVER commit these) ──────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
.secrets/
wrangler.toml.bak

# ── Databases (local runtime state) ──────────────────────────
*.db
*.sqlite
*.sqlite3
*.duckdb
memory/chroma/

# ── Ollama / AI Models (huge) ────────────────────────────────
*.gguf
*.bin
*.safetensors
models/
.ollama/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
*.icloud

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*~

# ── Logs & temp ───────────────────────────────────────────────
logs/
*.log
*.tmp
*.bak
*.orig
_quarantine_duplicates/
reports/

# ── Audio / Media (large — keep in THE-AQUARIUM) ─────────────
