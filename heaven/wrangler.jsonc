  // ☐ FEATURE_FLAGS + GAP_SOLVER KV — create then update IDs below
  // ═══════════════════════════════════════════════════════════════════════════

  "name": "heaven",
  "main": "src/index.js",
  "compatibility_date": "2026-04-06",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "5f36aa9795348ea681d0b21910dfc82a",

  // ── Workers AI (Edge Inference) ────────────────────────────────────────────
  // Models: @cf/meta/llama-3.1-8b-instruct, @cf/openai/whisper,
  //         @cf/stabilityai/stable-diffusion-xl-base-1.0
  "ai": {
    "binding": "AI"
  },

  // ── D1 Database ────────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "GABRIEL_DB",
      "database_name": "gabriel_db",
      "database_id": "a31d68e2-f2d4-4203-a803-8039fdff31cb"  // CANONICAL
    }
  ],

  // ── R2 Object Storage (Voice Vault) ────────────────────────────────────────
  // Bucket created: noizy-voice-vault
  // To activate: npx wrangler r2 bucket create noizy-voice-vault
  // Then uncomment:
  // "r2_buckets": [
  //   {
  //     "binding": "VOICE_VAULT",
  //     "bucket_name": "noizy-voice-vault"
  //   }
  // ],

  // ── KV Namespaces ──────────────────────────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "GABRIEL_KV",
      "id": "f205b56a9914413da0ec454a9dc4c2bd"          // CANONICAL
    },
    {
      "binding": "GABRIEL_VOICE",
      "id": "16532a32b2e8455486cc966403f3442e"          // CANONICAL
    }
    // SETUP: npx wrangler kv namespace create "FEATURE_FLAGS"
    // Then replace CREATE_AFTER_SETUP with real ID:
    // { "binding": "FEATURE_FLAGS", "id": "CREATE_AFTER_SETUP" },
    // SETUP: npx wrangler kv namespace create "GAP_SOLVER"
    // { "binding": "GAP_SOLVER",    "id": "CREATE_AFTER_SETUP" }
  ],

  // ── Environment Variables ──────────────────────────────────────────────────
  "vars": {
    "NOIZY_ENV": "production",
    "NOIZY_VERSION": "18.1.0",
    "FOUNDING_ACTOR_FLOOR": "85",
    "STANDARD_ACTOR_FLOOR": "75",
    "VOICE_VAULT_BUCKET": "noizy-voice-vault",
    "MESH_ORIGIN": "https://mesh.noizy.ai"
  },

  // ── Observability ──────────────────────────────────────────────────────────
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // ── Environments ───────────────────────────────────────────────────────────
  "env": {
    "preview": {
      "name": "heaven-preview",
      "vars": {
        "NOIZY_ENV": "preview",
        "NOIZY_VERSION": "18.1.0"
      }
    },
    "canary": {
      "name": "heaven-canary",
      "vars": {
        "NOIZY_ENV": "canary",
        "NOIZY_VERSION": "18.1.0"
      }
    },
    "production": {
      "name": "heaven",
      "vars": {
        "NOIZY_ENV": "production",
        "NOIZY_VERSION": "18.1.0"
      }
    }
  }

  // ── Custom Domains ─────────────────────────────────────────────────────────
  // noizy.ai is NOW ACTIVE in Cloudflare (marek/tara nameservers confirmed)
  // Uncomment after: wrangler login + zone confirmed Active in dashboard
  //
  // "routes": [
  //   { "pattern": "heaven.noizy.ai",   "custom_domain": true },
  //   { "pattern": "noizy.ai/*",         "zone_name": "noizy.ai" }
  // ]
}
