{
  "info": {
    "name": "NOIZY.AI — HEAVEN API v1",
    "description": "Complete test collection for HEAVEN Consent Kernel.\n\nAll 16 endpoints. Contract tests, validation tests, and integration tests.\n\nAuthor: Robert Stephen Plowman\nGenerated: 2026-04-13",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "{{HEAVEN_URL}}" },
    { "key": "actor_id", "value": "RSP_001" },
    { "key": "licensee_id", "value": "LIC_TEST_001" }
  ],
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "GET / — Root Info",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has name HEAVEN', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.name).to.equal('HEAVEN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/health — System Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 503', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "pm.test('Has status field', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.be.oneOf(['ok', 'degraded']);",
                  "});",
                  "pm.test('Has database status', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.databases).to.have.property('agent_memory');",
                  "  pm.expect(body.databases).to.have.property('gabriel_db');",
                  "});",
                  "pm.test('Has KV status', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.kv).to.have.all.keys('voice', 'gabriel', 'flags', 'gaps');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/stats — System Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has stats object', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.stats).to.have.all.keys('actors', 'consent_tokens', 'ledger_entries', 'never_clauses', 'waitlist_signups');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Never Clauses",
      "item": [
        {
          "name": "GET /v1/never-clauses — Constitutional Rules",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/never-clauses"
