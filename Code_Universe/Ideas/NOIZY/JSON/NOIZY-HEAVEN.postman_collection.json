          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns clauses array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.clauses).to.be.an('array');",
                  "  pm.expect(body.count).to.be.a('number');",
                  "});",
                  "pm.test('Clauses are constitutional (9 never clauses)', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.count).to.be.at.least(9);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
