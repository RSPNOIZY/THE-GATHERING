                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/actors/:actor_id — Single Actor",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/actors/{{actor_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns actor or 404', () => {",
