          ]
        }
      ]
    },
    {
      "name": "Consent",
      "item": [
        {
          "name": "POST /v1/consent/check — Consent Verification",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/consent/check",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actor_id\": \"{{actor_id}}\",\n  \"licensee_id\": \"{{licensee_id}}\",\n  \"use_case\": \"commercial_voiceover\",\n  \"jurisdiction\": \"CA-ON\",\n  \"medium\": \"broadcast\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns consent decision', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 404]);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200 || pm.response.code === 403) {",
                  "    pm.expect(body.decision).to.have.property('allowed');",
                  "    pm.expect(body.decision).to.have.property('reason');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/consent/grant — Issue Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/consent/grant",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actor_id\": \"{{actor_id}}\",\n  \"licensee_id\": \"{{licensee_id}}\",\n  \"scope\": {\n    \"use_cases\": [\"commercial_voiceover\"],\n    \"jurisdictions\": [\"CA-ON\"],\n    \"mediums\": [\"broadcast\", \"streaming\"]\n  },\n  \"duration_days\": 365\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns token or error', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 404]);",
                  "  if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token_id).to.match(/^CT-/);",
                  "    pm.expect(body.status).to.equal('active');",
                  "    pm.collectionVariables.set('consent_token_id', body.token_id);",
                  "  }",
                  "});",
                  "pm.test('Idempotency-Key required', () => {",
                  "  // This test validates the header was sent",
                  "  pm.expect(pm.request.headers.get('Idempotency-Key')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/consent/revoke — Revoke Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/consent/revoke",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token_id\": \"{{consent_token_id}}\",\n  \"actor_id\": \"{{actor_id}}\",\n  \"reason\": \"Testing revocation flow\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns revoked or error', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
