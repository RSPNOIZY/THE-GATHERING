{
  "name": "NOIZY · Heaven & Domain Sentinel",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://heaven.rsp-5f3.workers.dev/",
        "options": { "timeout": 10000 }
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Probe Heaven",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "or",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "alive",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ]
        },
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Heaven NOT alive?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_YOUR_SLACK_OR_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🚨 HEAVEN SENTINEL: worker not 'alive'. status={{ $json.status }} at {{ $now }}\"\n}",
        "options": {}
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Alert (down)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [960, 200]
    },
    {
      "parameters": {},
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "OK — no-op",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 400]
    }
  ],
  "connections": {
    "Every 15 min": {
      "main": [[{ "node": "Probe Heaven", "type": "main", "index": 0 }]]
    },
    "Probe Heaven": {
      "main": [[{ "node": "Heaven NOT alive?", "type": "main", "index": 0 }]]
    },
    "Heaven NOT alive?": {
      "main": [
        [{ "node": "Alert (down)", "type": "main", "index": 0 }],
        [{ "node": "OK — no-op", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templatecredsSetupCompleted": false }
}
