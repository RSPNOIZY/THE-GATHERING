{
  "name": "consent-gateway",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute consent_gateway --remote --file=schema.sql",
