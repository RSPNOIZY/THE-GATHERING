{
  "name": "noizy-voice",
  "displayName": "NOIZY Voice Input",
  "description": "Adaptive voice input for NOIZY creative workflow — dictate, capture, command, GABRIEL",
  "version": "1.0.0",
  "publisher": "noizylab",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "voice",
    "speech",
    "adaptive",
    "noizy",
    "dictation",
    "accessibility"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noizy-voice.toggle",
        "title": "NOIZY Voice: Toggle Recording",
        "icon": "$(record)"
      },
      {
        "command": "noizy-voice.openPanel",
        "title": "NOIZY Voice: Open Panel",
        "icon": "$(unmute)"
      },
      {
        "command": "noizy-voice.setMode",
        "title": "NOIZY Voice: Set Mode"
      },
      {
        "command": "noizy-voice.dictate",
        "title": "NOIZY Voice: Dictate at Cursor"
      },
      {
        "command": "noizy-voice.intake",
        "title": "NOIZY Voice: Capture to Inbox"
      }
    ],
    "keybindings": [
      {
        "command": "noizy-voice.toggle",
        "key": "ctrl+shift+space",
        "mac": "ctrl+shift+space",
        "when": "editorTextFocus"
      },
      {
        "command": "noizy-voice.openPanel",
        "key": "ctrl+alt+v",
        "mac": "ctrl+alt+v"
      },
      {
        "command": "noizy-voice.setMode",
        "key": "ctrl+shift+m",
        "mac": "ctrl+shift+m",
        "when": "noizyVoiceActive"
      }
    ],
    "configuration": {
      "title": "NOIZY Voice",
      "properties": {
        "noizyVoice.defaultMode": {
          "type": "string",
          "enum": [
            "dictate",
            "intake",
            "command",
            "capture"
          ],
          "enumDescriptions": [
            "Type transcribed text at cursor",
            "Append to ideas/inbox.md with timestamp",
            "Send to Claude inline chat",
            "Create new timestamped session entry"
          ],
          "default": "dictate",
          "description": "Default voice input mode on startup"
        },
        "noizyVoice.inboxPath": {
          "type": "string",
          "default": "ideas/inbox.md",
          "description": "Relative path to NOIZY ideas inbox"
        },
        "noizyVoice.language": {
          "type": "string",
          "default": "en-US",
          "description": "Speech recognition language (BCP-47 tag)"
        },
        "noizyVoice.interimResults": {
          "type": "boolean",
          "default": true,
          "description": "Show live partial transcription as you speak"
        },
        "noizyVoice.autoCapitalize": {
          "type": "boolean",
          "default": true,
          "description": "Auto-capitalize start of dictated sentences"
        },
        "noizyVoice.gabrielUrl": {
          "type": "string",
          "default": "ws://10.90.90.10:7777/voice",
          "description": "GABRIEL WebSocket URL — voice broadcast channel"
        },
        "noizyVoice.transcriptionModel": {
          "type": "string",
          "enum": [
            "webspeech",
            "moonshine",
            "whisper-cloud"
          ],
          "default": "webspeech",
          "description": "Transcription engine: webspeech (browser native), moonshine (local, privacy-first), whisper-cloud (OpenAI API)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}