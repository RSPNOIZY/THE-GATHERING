        }
      },
      "id": "n7b-notion-update",
      "name": "N7b · Update Notion (Linear linked)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [1580, 380],
      "credentials": {
        "notionApi": {
          "id": "notion-integration",
          "name": "Notion (RSP_001)"
        }
      },
      "continueOnFail": true
    },

    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.route }}",
        "rules": {
          "rules": [
            { "value2": "GOD",     "output": 0 },
            { "value2": "LUCY",    "output": 1 },
            { "value2": "GABRIEL", "output": 2 },
            { "value2": "MC96",    "output": 3 },
            { "value2": "GREP",    "output": 4 },
            { "value2": "DREAM",   "output": 5 }
          ]
        },
        "fallbackOutput": 6
      },
      "id": "n8-switch",
      "name": "N8 · Route Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1340, 680]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LUCY_WEBHOOK_URL || 'http://localhost:7778/command' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ route: $json.route, command: $json.command, intent: $json.intent, urgency: $json.urgency, payload: $json.payload, ts: $json.ts }) }}"
      },
      "id": "n9a-lucy",
      "name": "N9a · Forward → LUCY",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 580],
      "continueOnFail": true
    },

    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GABRIEL_WEBHOOK_URL || 'http://localhost:7779/command' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ route: $json.route, command: $json.command, intent: $json.intent, urgency: $json.urgency, payload: $json.payload, ts: $json.ts }) }}"
      },
      "id": "n9b-gabriel",
      "name": "N9b · Forward → GABRIEL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 700],
      "continueOnFail": true
    },

    {
      "parameters": {
        "jsCode": "const { command, payload } = $json;\nreturn [{ json: { handled: true, agent: 'MC96', command, payload, ts: new Date().toISOString() } }];\n"
      },
      "id": "n9c-mc96",
      "name": "N9c · MC96 Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 820],
      "continueOnFail": true
    },

    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, route: $('N2 · Auth + Parse + Classify').item.json.route, intent: $('N2 · Auth + Parse + Classify').item.json.intent, urgency: $('N2 · Auth + Parse + Classify').item.json.urgency, notion_id: $('N4 · Notion → Command Inbox').item.json.id || null, ts: $('N2 · Auth + Parse + Classify').item.json.ts }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "n10-respond",
      "name": "N10 · Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1820, 600]
    }

  ],

