      "parameters": {
        "command": "={{$env.GREP_SWARM_CMD || 'rg --json --type-add \"web:*.{html,js,ts,tsx,jsx,css}\" \"TODO|FIXME|HACK|NEVER CLAUSE|consent|kill switch\" ' + $json.path + ' | head -200'}}",
        "options": {}
      },
      "id": "grep-exec",
      "name": "Execute grep",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [940, 350]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate grep results, tag by brand, route to owner agent\nconst items = $input.all();\nconst byOwner = {};\nfor (const i of items) {\n  const brand = i.json.brand;\n  const owner = i.json.owner;\n  const raw = i.json.stdout || '';\n  const lines = raw.split('\\n').filter(Boolean);\n  byOwner[owner] = byOwner[owner] || {};\n  byOwner[owner][brand] = { count: lines.length, lines: lines.slice(0, 50) };\n}\nreturn [\n  { json: { route: 'GABRIEL', payload: byOwner.GABRIEL || {} } },\n  { json: { route: 'LUCY',    payload: byOwner.LUCY || {} } }\n];\n"
      },
      "id": "aggregate-route",
      "name": "Aggregate + route to GABRIEL/LUCY",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://heaven.rsp-5f3.workers.dev/api/v1/ledger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-NOIZY-Key", "value": "={{$env.NOIZY_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"event\":\"mc96_grep_swarm\",\"route\":\"{{$json.route}}\",\"ts\":\"{{$now.toISOString()}}\",\"summary\":{{JSON.stringify($json.payload)}}}"
      },
      "id": "ledger-log",
      "name": "Log to HEAVEN ledger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 350]
