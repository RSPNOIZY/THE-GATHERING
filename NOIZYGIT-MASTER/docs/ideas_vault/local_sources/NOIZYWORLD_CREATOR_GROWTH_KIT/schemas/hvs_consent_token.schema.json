{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noizyfish.com/schemas/hvs_consent_token.schema.json",
  "title": "HVS Consent Token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "jti",
    "nbf",
    "exp",
    "scope",
    "asset_hashes",
    "allowed_actions",
    "forbidden_actions",
    "consent_record_id",
    "revocation_pointer",
    "reason_code",
    "proof"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "sub": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "aud": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "jti": {
      "type": "string",
      "pattern": "^hvs_tok_[a-zA-Z0-9_-]{16,96}$"
    },
    "nbf": {
      "type": "string",
      "format": "date-time"
    },
    "exp": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "enum": [
        "asset.preview",
        "asset.download",
        "asset.remix",
        "asset.license.sync",
        "asset.license.sample",
        "asset.train.ai",
        "asset.infer.ai",
        "voice.clone",
        "voice.avatar",
        "identity.bind",
        "distribution.publish",
        "payout.execute"
      ]
    },
    "asset_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "split_sheet_id": {
      "type": "string",
      "pattern": "^split_[a-zA-Z0-9_-]{12,96}$"
    },
    "consent_record_id": {
      "type": "string",
      "pattern": "^consent_[a-zA-Z0-9_-]{12,96}$"
    },
    "revocation_pointer": {
      "type": "string",
      "pattern": "^hvs://revocations/[a-zA-Z0-9_./-]{8,256}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,80}$"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "alg",
        "crv",
        "key_id",
        "signature"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "Ed25519Signature2026"
        },
        "alg": {
          "type": "string",
          "const": "EdDSA"
        },
        "crv": {
          "type": "string",
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64,256}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "enum": [
              "asset.license.sync",
              "asset.license.sample",
              "distribution.publish",
              "payout.execute"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "split_sheet_id"
        ]
      }
    }
  ],
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "preview",
        "download",
        "remix",
        "license_sync",
        "license_sample",
        "train_ai",
        "infer_ai",
        "clone_voice",
        "use_voice_avatar",
        "bind_identity",
        "publish",
        "execute_payout"
      ]
    }
  }
}
