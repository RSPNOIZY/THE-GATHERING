{"cells":[{"cell_type":"code","source":"import os\nimport json\nfrom pathlib import Path\n\n# ---------------------------------------------------------\n# THE HEALING CONFIGURATION\n# ---------------------------------------------------------\n# The blueprint we created during the NOIZY_SWEEP\nMANIFEST_PATH = \"/Users/robert/Desktop/NOIZY_MANIFEST_CURRENT.json\"\n\n# The zones we want to heal (e.g., your desktop, project folders)\nZONES_TO_HEAL = [\"/Users/robert/Desktop\", \"/Users/robert/Documents/Projects\"]\n\n# ---------------------------------------------------------\n# THE MEND LOGIC\n# ---------------------------------------------------------\ndef load_manifest():\n    \"\"\"Loads Gabriel's master map of the universe.\"\"\"\n    if not os.path.exists(MANIFEST_PATH):\n        print(\"🚨 [ERROR] Manifest not found. Run NOIZY_SWEEP first.\")\n        return None\n    with open(MANIFEST_PATH, 'r') as f:\n        return json.load(f)\n\ndef build_reverse_lookup(manifest):\n    \"\"\"Creates a lightning-fast dictionary to find any file by its name.\"\"\"\n    print(\"🧠 [GABRIEL] Building neural pathways from Manifest...\")\n    reverse_map = {}\n    for ext, paths in manifest.items():\n        for path in paths:\n            filename = os.path.basename(path)\n            # If there are duplicates, we store a list of possible locations\n            if filename not in reverse_map:\n                reverse_map[filename] = []\n            reverse_map[filename].append(path)\n    return reverse_map\n\ndef heal_broken_links(reverse_map):\n    \"\"\"Hunts down broken symlinks/aliases and reconnects them.\"\"\"\n    print(\"🔥 [GABRIEL] Initiating NOIZY_MEND on broken pathways...\")\n    healed_count = 0\n    unfixable_count = 0\n\n    for zone in ZONES_TO_HEAL:\n        if not os.path.exists(zone):\n            continue\n            \n        for root, dirs, files in os.walk(zone):\n            for file in files:\n                file_path = os.path.join(root, file)\n                \n                # Check if the file is a symlink (shortcut)\n                if os.path.islink(file_path):\n                    target_path = os.readlink(file_path)\n                    \n                    # If the target is missing, the link is BROKEN\n                    if not os.path.exists(target_path):\n                        broken_filename = os.path.basename(target_path)\n                        \n                        # 1. THE SEARCH: Look for the missing file in our reverse map\n                        if broken_filename in reverse_map:\n                            possible_matches = reverse_map[broken_filename]\n                            \n                            # If we found exactly one match, WE HEAL IT\n                            if len(possible_matches) == 1:\n                                new_target = possible_matches[0]\n                                \n                                # Remove the broken link and forge a new one\n                                os.unlink(file_path)\n                                os.symlink(new_target, file_path)\n                                \n                                print(f\"✨ [HEALED] {file} ➔ Reconnected to {new_target}\")\n                                healed_count +=","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}