# DreamChamber Environment Variables

# Server Configuration
PORT=7777
NODE_ENV=development

# API Keys (get from respective providers)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
OPENAI_API_KEY=sk-xxxxx
GOOGLE_API_KEY=AIzaxxxxx
TOGETHER_API_KEY=xxxxx
MISTRAL_API_KEY=xxxxx
COHERE_API_KEY=xxxxx
PERPLEXITY_API_KEY=pplx-xxxxx

# Heaven17 Consent Kernel (bridge)
HEAVEN_URL=https://heaven17.rsp-5f3.workers.dev
NOIZY_API_KEY=noizy-hvs-your-key-here

# Gabriel AI Orchestration Layer
# ANTHROPIC_API_KEY above is used by Gabriel for AI generation
GABRIEL_MODEL=claude-sonnet-4
GABRIEL_VOICE_NAME=Daniel
GABRIEL_SPEECH_RATE=180

# JWT Auth
JWT_SECRET=your-jwt-secret-here

# Voice Bridge (used by voice-bridge-server.js to call DreamChamber)
DREAMCHAMBER_URL=http://localhost:7777
VOICE_AUTH_TOKEN=your-voice-bridge-token-here

# PostgreSQL (used by Database.js — matches docker-compose postgres service)
DATABASE_URL=postgresql://dreamchamber:dreamchamber@localhost:5432/dreamchamber

# Optional: Redis for persistence (if needed later)
REDIS_URL=redis://localhost:6379

# Optional: Logging
LOG_LEVEL=info
LOG_FILE=dreamchamber.log
