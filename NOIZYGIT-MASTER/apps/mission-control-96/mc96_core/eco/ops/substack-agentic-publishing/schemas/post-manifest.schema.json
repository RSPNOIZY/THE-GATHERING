{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noizy.ai/schemas/substack-post-manifest.schema.json",
  "title": "NOIZY Substack Post Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "brand",
    "section",
    "status",
    "title",
    "audience",
    "send_email",
    "rights",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,120}$"
    },
    "brand": {
      "type": "string",
      "enum": [
        "NOIZY.AI",
        "NOIZYVOX",
        "NOIZYLAB",
        "NOIZYKIDZ",
        "FISHMUSICINC",
        "DREAMCHAMBER"
      ]
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "draft",
        "review",
        "ready_for_substack",
        "scheduled",
        "published",
        "archived"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subtitle": {
      "type": "string",
      "maxLength": 240
    },
    "audience": {
      "type": "string",
      "enum": [
        "everyone",
        "free_subscribers",
        "paid_subscribers",
        "founding_members",
        "private_review"
      ]
    },
    "send_email": {
      "type": "boolean"
    },
    "publish_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "rights_status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "audio",
              "video",
              "transcript",
              "data",
              "other"
            ]
          },
          "rights_status": {
            "type": "string",
            "enum": [
              "owned",
              "licensed",
              "public_domain",
              "needs_review",
              "blocked"
            ]
          }
        }
      },
      "default": []
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url_or_path"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url_or_path": {
            "type": "string"
          },
          "checked_on": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "default": []
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice_consent_checked",
        "music_rights_checked",
        "image_rights_checked",
        "contains_child_safety_review",
        "approved_for_public_distribution"
      ],
      "properties": {
        "voice_consent_checked": {
          "type": "boolean"
        },
        "music_rights_checked": {
          "type": "boolean"
        },
        "image_rights_checked": {
          "type": "boolean"
        },
        "contains_child_safety_review": {
          "type": "boolean"
        },
        "approved_for_public_distribution": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_check_complete",
        "human_approved",
        "substack_preview_checked",
        "test_email_checked"
      ],
      "properties": {
        "fact_check_complete": {
          "type": "boolean"
        },
        "human_approved": {
          "type": "boolean"
        },
        "substack_preview_checked": {
          "type": "boolean"
        },
        "test_email_checked": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "published": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "rss_seen_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
