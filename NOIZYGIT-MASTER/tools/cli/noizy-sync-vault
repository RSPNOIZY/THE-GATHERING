#!/usr/bin/env bash
set -euo pipefail
VAULT="$HOME/RSPNOIZY/THE-GATHERING/GITHUBVAULT"
LOG="$VAULT/_logs/sync-$(date +%Y%m%d-%H%M%S).log"
PARALLEL="${PARALLEL:-6}"

{
  echo "=== Universe Map sync: $(date -u +%FT%TZ) ==="
  find "$VAULT" -type d -name '*.git' -maxdepth 3 -print0 \
    | xargs -0 -n1 -P "$PARALLEL" -I{} bash -c 'git -C "$1" remote update --prune >/dev/null 2>&1 && echo "OK   $1" || echo "FAIL $1"' _ {}
  echo "=== Done: $(date -u +%FT%TZ) ==="
} | tee -a "$LOG"
