# MC96 Universe — Environment Configuration
# Copy this to .env and customize for your network

# ── Node Identity ─────────────────────────────────────────────
MC96_NODE_NAME=M2_ULTRA_CONTROLLER
MC96_ROLE=controller

# ── Network ───────────────────────────────────────────────────
# Set this to the Tailscale IP of the controller (M2 Ultra)
CONTROLLER_IP=100.x.x.x

MC96_HIVE_PORT=8096
MC96_SSH_PORT=2222

# ── Storage ───────────────────────────────────────────────────
MC96_VOLUMES_ROOT=/volumes
MC96_REGISTRY_PATH=/data/mc96_hive_registry.json
MC96_LOG_DIR=/data/logs

# ── rsync Daemon Password ─────────────────────────────────────
MC96_RSYNC_PASS=mc96universe

# ── Docker build platform ─────────────────────────────────────
# linux/arm64  → Apple Silicon (M1/M2/M3)
# linux/amd64  → Intel Macs, Linux x86_64
MC96_PLATFORM=linux/arm64
