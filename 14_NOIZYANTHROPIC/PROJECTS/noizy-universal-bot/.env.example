# ── Discord ───────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → enable MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Guild-scoped commands deploy instantly. Leave empty for global (24h propagation).
DISCORD_GUILD_ID=

# ── Slack (Socket Mode) ───────────────────────────────────────────────────────
# https://api.slack.com/apps → Socket Mode ON → generate App-Level Token (xapp-…)
# Bot scopes needed: chat:write, files:read, reactions:write, commands, app_mentions:read,
#                    channels:history, im:history
# Subscribe to bot events: file_shared, app_mention
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# ── MCP voice ingest endpoint (JSON-RPC 2.0) ──────────────────────────────────
MCP_VOICE_URL=https://mcp.noizy.ai/voice
NOIZY_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Health + NCP HTTP server port
HEALTH_PORT=8088
