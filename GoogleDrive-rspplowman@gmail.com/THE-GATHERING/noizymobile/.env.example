# NOIZYMOBILE Environment Config
# Copy to .env and fill in secrets — never commit the filled version

# ── Auth ───────────────────────────────────────────────────────
NOIZY_BRIDGE_SECRET=crv-cockpit-secret-key

# ── Cloudflare D1 dispatcher ────────────────────────────────────
D1_API_BASE=https://dispatch.noizyfish.com
D1_WORKER_TOKEN=

# ── Gabriel queue (internal Tailscale IP or localhost) ──────────
GABRIEL_WEBHOOK_URL=http://100.x.x.x:9000/gabriel/queue

# ── Logging ────────────────────────────────────────────────────
NOIZY_LOG_DIR=/var/log/noizymobile
