{
  "info": {
    "_postman_id": "8f92bc1a-2026-4cf1-a992-noizy001",
    "name": "NOIZY Sovereign Runtime v2.4.0-PROD",
    "description": "Postman Collection for NOIZY Sovereign Operating System across all 13 Parallel Lanes:\n- Google Routes API v2 (Traffic-Aware Routing)\n- Cloudflare D1 Harmony Ledger (2-Phase Receipts)\n- Consent Oracle (Law 25 / NC-01-10-v2)\n- Pushcut Dispatcher (Universal CarPlay Handoff)\n- Sonic Passport (Durable Object Asset Correlation)\n- Telemetry & Fleet Mesh",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Consent Oracle (Law 25 / NC-01-10-v2)",
      "item": [
        {
          "name": "Verify Driver Consent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-noizy-key", "value": "{{NOIZY_INTERNAL_KEY}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_id\": \"{{DRIVER_ID}}\",\n  \"policy_code\": \"NC-01-10-v2\",\n  \"token_hash\": \"{{SESSION_TOKEN_HASH}}\",\n  \"allowed_purpose\": \"traffic_eta\"\n}"
            },
            "url": {
              "raw": "{{HARMONY_LEDGER_URL}}/api/v1/consent/verify",
              "host": ["{{HARMONY_LEDGER_URL}}"],
              "path": ["api", "v1", "consent", "verify"]
            }
          }
        },
        {
          "name": "Revoke Consent (Fail-Closed Trigger)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-noizy-key", "value": "{{NOIZY_INTERNAL_KEY}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_id\": \"{{DRIVER_ID}}\",\n  \"policy_code\": \"NC-01-10-v2\",\n  \"status\": \"REVOKED\"\n}"
            },
            "url": {
              "raw": "{{HARMONY_LEDGER_URL}}/api/v1/consent/revoke",
              "host": ["{{HARMONY_LEDGER_URL}}"],
              "path": ["api", "v1", "consent", "revoke"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Google Routes API v2 (Traffic-Aware)",
      "item": [
        {
          "name": "Compute Traffic-Aware Route (POST computeRoutes)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Goog-Api-Key", "value": "{{GOOGLE_MAPS_API_KEY}}" },
              { "key": "X-Goog-FieldMask", "value": "routes.duration,routes.staticDuration,routes.distanceMeters,routes.polyline.encodedPolyline,routes.description" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"location\": { \"latLng\": { \"latitude\": 45.4215, \"longitude\": -75.6972 } }\n  },\n  \"destination\": {\n    \"location\": { \"latLng\": { \"latitude\": 45.3225, \"longitude\": -75.6692 } }\n  },\n  \"travelMode\": \"DRIVE\",\n  \"routingPreference\": \"TRAFFIC_AWARE\",\n  \"computeAlternativeRoutes\": false\n}"
            },
            "url": {
              "raw": "https://routes.googleapis.com/directions/v2:computeRoutes",
              "protocol": "https",
              "host": ["routes", "googleapis", "com"],
              "path": ["directions", "v2:computeRoutes"]
            }
          }
        }
      ]
    },
